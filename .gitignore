# Secrets — defense in depth. The app stores keys in
# ~/Library/Application Support/com.onetruedutchie.app/keys.json,
# never inside the repo. These patterns block accidental commits
# if someone copies that file or generates one in the project dir.
keys.json
*.key
*.pem
*.p12
**/secrets/
*.secret
